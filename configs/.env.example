# Локальная БД; не использовать порт чужого контейнера при интеграционных тестах.
DATABASE_URL=postgres://autocheck:autocheck@localhost:5432/autocheck?sslmode=disable
OIDC_ISSUER=http://localhost:8180/realms/autocheck
S3_ENDPOINT=localhost:8333
S3_BUCKET=autocheck
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Оба ключа пусты — оформление подписки выключено, free-лимиты продолжают действовать.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT=10s
BILLING_SYNC_INTERVAL=30s

# Предельное время одной операции БД при обработке запросов пользователей.
FEEDBACK_QUERY_TIMEOUT=5s

# Отдельный Prometheus listener у api и worker; порт доступен только в служебной сети.
METRICS_ADDR=:9100
# Снимок глобальной очереди снимает каждый worker, не HTTP scrape-handler.
METRICS_POLL_INTERVAL=5s
METRICS_QUERY_TIMEOUT=3s

# Учебные материалы: таймауты БД/S3 и максимальный размер PDF/картинки (байты).
MATERIAL_QUERY_TIMEOUT=5s
MATERIAL_OBJECT_TIMEOUT=30s
MATERIAL_MAX_ATTACHMENT_BYTES=10485760

# Таймаут операций БД playground в API и worker; положительная длительность.
PLAYGROUND_QUERY_TIMEOUT=5s

# HPRPR-10: без LLM_API_KEY новые ИИ-генерации недоступны, остальной API работает.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Общий deadline вместе с повторами; максимум 5 повторов после первой попытки.
LLM_TIMEOUT=2m
LLM_RETRIES=2
# Включает reasoning; слишком маленький лимит часто оставляет пустой ответ.
LLM_MAX_TOKENS=8192

# HPRPR-5: бесплатный подбор, дневная квота на пользователя по UTC, включая текстовый поиск.
RECOMMENDATION_DAILY_LIMIT=30
RECOMMENDATION_QUERY_TIMEOUT=5s
# API обновляет до 16 изменённых опубликованных заданий за один проход.
RECOMMENDATION_REFRESH_INTERVAL=1m
